# =============================================================================
# QuietPatch Environment Configuration
# =============================================================================

# Application Execution Mode: 'local' | 'hosted'
# - local: Privacy-first; code remains on your machine; file modifications allowed upon approval.
# - hosted: Production web deployment (e.g., Render); read-only preview mode for security.
APP_MODE=local

# AI Caretaker Provider: 'ollama' | 'gemma_api' | 'demo'
# - ollama: Local inference using Ollama daemon.
# - gemma_api: Hosted Gemma model via official Google Gen AI Python SDK.
# - demo: Offline, zero-credential demonstration mode with deterministic findings.
AI_PROVIDER=demo

# Local Gemma Settings (Mode A: Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
# Request timeout in seconds for local Gemma inference (default 240.0)
OLLAMA_REQUEST_TIMEOUT_SECONDS=240.0
# Ollama in-memory keep-alive duration to prevent repeated model reloading (default 15m)
OLLAMA_KEEP_ALIVE=15m
# Number of findings evaluated per inference request (default 3)
OLLAMA_BATCH_SIZE=3

# Hosted Gemma Settings (Mode B: Google Gen AI)
# Leave blank to use Demo Mode without credentials
GEMMA_API_KEY=
GEMMA_API_MODEL=gemma-4-26b-a4b-it
GEMMA_API_MAX_RETRIES=2
GEMMA_API_BACKOFF_FACTOR=0.5
GEMMA_API_MAX_OUTPUT_TOKENS=2048
GEMMA_API_RECOVERY_MAX_TOKENS=3072
GEMMA_API_BATCH_SIZE=3
# Wall-clock budget per analysis batch (initial + retries + backoff). Default 120s.
GEMMA_API_RETRY_BUDGET_SECONDS=120.0
# Per-request timeout in seconds. CRITICAL: the google-genai SDK sends this as both the
# httpx client read timeout AND the X-Server-Timeout header (Google's upstream server
# hard deadline). Setting below actual generation time causes HTTP 504 DEADLINE_EXCEEDED.
# Production evidence: successful runs take 20-23s. 60s gives adequate headroom.
# Google enforces a minimum of 10s (below this = HTTP 400 INVALID_ARGUMENT).
GEMMA_API_REQUEST_TIMEOUT_SECONDS=60.0
# Overall wall-clock budget for patch proposal including recovery attempt. Default 90s.
GEMMA_API_PATCH_TIMEOUT_SECONDS=90.0
# Token limits for patch generation: initial keeps requests compact (2048),
# recovery must be larger (4096) to provide adequate headroom if initial generation truncated.
GEMMA_API_PATCH_MAX_OUTPUT_TOKENS=2048
GEMMA_API_PATCH_RECOVERY_MAX_TOKENS=4096
# Thinking level for Gemma 4 patch generation: 'minimal' prevents thinking tokens from exhausting the output budget
GEMMA_API_PATCH_THINKING_LEVEL=minimal

# Security Boundaries (Local Mode)
# Strict root path containment: QuietPatch will reject any inspection outside this path.
QUIETPATCH_ALLOWED_ROOT=.

# Sentry Agent Tracing & Observability
# Leave blank to run with local offline stage duration tracking.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=development

# Resource Guardrails
MAX_REPO_FILES=500
MAX_REPO_BYTES=10485760
MAX_SCAN_SECONDS=60
